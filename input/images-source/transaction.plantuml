@startuml
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #FFF8E8
  BorderColor #555555
}
skinparam actorStyle stickman
skinparam packageStyle rectangle

rectangle "uc Use Case - Ambulance referral to GP or GP out-of-hours service" {

  actor "General practitioner" as gp
  actor "GP out-of-hours service" as hap
  actor "Ambulance" as ambulance

  usecase "Receiving referral" as receiving
  usecase "Sending referral" as sending
  usecase "Referral (PUSH)" as push

  rectangle "AZP-AVO" as avo {
    usecase "Receiving referral" as receiving_avo
  }

  rectangle "AZP-AVS" as avs {
    usecase "Sending referral" as sending_avs
  }

  gp -- receiving
  hap -- receiving
  ambulance -- sending

  receiving ..> receiving_avo
  sending ..> sending_avs

  receiving_avo ..> push : <<include>>
  sending_avs ..> push : <<include>>
}

@enduml